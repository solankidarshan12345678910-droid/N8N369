{
  "name": "Windows-like Cloud Desktop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Cloud Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "/usr/local/bin/start-desktop.sh >/tmp/cloud-desktop.log 2>&1 &",
  "remoteUser": "vscode"
}
